generator client {
  provider = "prisma-client-js"
}

// 💡 ໃຫ້ມີ datasource db ພຽງບ່ອນດຽວ
datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// 👤 ຕາຕະລາງຜູ້ໃຊ້ງານ (User)
model User {
  id        Int      @id @default(autoincrement())
  username  String   @unique
  password  String
  fullName  String
  role      String   @default("FINANCE_STAFF") // ADMIN, DIRECTOR, FINANCE_STAFF, ASSET_STAFF
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// 💵 ຕາຕະລາງລາຍຮັບ (Income)
model Income {
  id          Int      @id @default(autoincrement())
  referenceNo String?  // ເລກບິນສັ່ງຈ່າຍ
  date        String   // ວັນທີ
  description String   // ເນື້ອໃນລາຍການ
  disburser   String?  // ຜູ້ເບີກເງິນ
  receiver    String?  // ຜູ້ຮັບເງິນ
  amount      Float    // ຈຳນວນເງິນ
  remark      String?  // ໝາຍເຫດ
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// 💸 ຕາຕະລາງລາຍຈ່າຍ (Expense)
model Expense {
  id          Int      @id @default(autoincrement())
  referenceNo String?  // ເລກບິນສັ່ງຈ່າຍ
  date        String   // ວັນທີ
  category    String   @default("ຄ່າບໍລິຫານທົ່ວໄປ") // ໝວດໝູ່ລາຍຈ່າຍ
  description String   // ເນື້ອໃນລາຍການ
  disburser   String?  // ຜູ້ເບີກເງິນ
  receiver    String?  // ຜູ້ຮັບເງິນ
  amount      Float    // ຈຳນວນເງິນ
  budgetId    Int?     // ID ຂອງໂຄງການ (ຖ້າຕັດຈາກງົບປະມານໂຄງການ)
  budgetName  String?  // ຊື່ໂຄງການ (ສຳລັບສະແດງຜົນ)
  remark      String?  // ໝາຍເຫດ
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// 📊 ຕາຕະລາງງົບປະມານ (Budget)
model Budget {
  id           Int      @id @default(autoincrement())
  projectName  String   // ຊື່ໂຄງການ/ງົບປະມານ
  categoryName String   // ໝວດໝູ່ / ແຫຼ່ງທຶນ
  totalAmount  Float    // ງົບປະມານທັງໝົດ
  isDeduct     Boolean  @default(false) // ຫັກເງິນບໍລິຫານຫຼືບໍ່
  deductType   String   @default("percent") // percent ຫຼື amount
  deductValue  Float    @default(0) // ຄ່າທີ່ປ້ອນ (ເຊັ່ນ 10% ຫຼື 5,000,000)
  deductAmount Float    @default(0) // ຈຳນວນເງິນທີ່ຖືກຫັກຈິງ
  netAmount    Float    // ງົບປະມານສຸດທິເຫຼືອໃຊ້ໃນໂຄງການ
  usedAmount   Float    @default(0) // ຍອດໃຊ້ໄປແລ້ວ
  startDate    String?  // ວັນທີເລີ່ມຕົ້ນ
  endDate      String?  // ວັນທີສິ້ນສຸດ
  detail       String?  // ລາຍລະອຽດ
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// 📦 ຕາຕະລາງຊັບສິນ (Asset)
model Asset {
  id           Int      @id @default(autoincrement())
  assetCode    String   @unique // ລະຫັດຊັບສິນ (ເຊັ່ນ COM-2026-001)
  name         String   // ຊື່ຊັບສິນ
  categoryName String   // ໝວດໝູ່ຊັບສິນ
  purchaseDate String   // ວັນທີຈັດຊື້
  price        Float    // ມູນຄ່າຊື້ (ກີບ)
  assignedTo   String   // ຜູ້ຮັບຜິດຊອບ / ບ່ອນຕັ້ງ
  status       String   @default("available") // available, in_use, maintenance, broken
  attachment   String?  // 💡 ເພີ່ມຖັນນີ້ສຳລັບເກັບຊື່ໄຟລ໌ຮູບພາບ/ເອກະສານ
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}