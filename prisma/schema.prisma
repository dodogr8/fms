generator client {
  provider = "prisma-client-js"
}

// 💡 ໃຫ້ມີ datasource db ພຽງບ່ອນດຽວ
datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// 👤 ຕາຕະລາງຜູ້ໃຊ້ງານ (User)
model User {
  id        Int      @id @default(autoincrement())
  username  String   @unique
  password  String
  fullName  String
  role      String   @default("FINANCE_STAFF") // ADMIN, DIRECTOR, FINANCE_STAFF, ASSET_STAFF
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// 💵 ຕາຕະລາງລາຍຮັບ (Income)
model Income {
  id            Int      @id @default(autoincrement())
  referenceNo   String?  // ເລກບິນສັ່ງຈ່າຍ
  date          String   // ວັນທີ
  incomeType    String   @default("REGULAR") // REGULAR = ບໍລິຫານ/ປົກກະຕິ(ໃຊ້ໄດ້ເລີຍ), FEE_SERVICE = ຄ່າທຳນຽມ&ບໍລິການ
  categoryName  String?  @default("ລາຍຮັບທົ່ວໄປ")
  description   String   // ເນື້ອໃນລາຍການ
  disburser     String?  // ຜູ້ເບີກ/ຜູ້ມອບ
  receiver      String?  // ຜູ້ຮັບ
  amount        Decimal  @db.Decimal(15, 2)
  feeAmount     Decimal  @default(0) @db.Decimal(15, 2)
  serviceAmount Decimal  @default(0) @db.Decimal(15, 2)
  remark        String?  // ໝາຍເຫດ
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// 💸 ຕາຕະລາງລາຍຈ່າຍ (Expense)
model Expense {
  id          Int      @id @default(autoincrement())
  referenceNo String?  // ເລກບິນສັ່ງຈ່າຍ
  date        String   // ວັນທີ
  category    String   @default("ຄ່າບໍລິຫານທົ່ວໄປ") // ໝວດໝູ່ລາຍຈ່າຍ
  description String   // ເນື້ອໃນລາຍການ
  disburser   String?  // ຜູ້ເບີກເງິນ
  receiver    String?  // ຜູ້ຮັບເງິນ
  amount      Decimal  @db.Decimal(15, 2)
  budgetId    Int?     // ID ຂອງໂຄງການ (ຖ້າຕັດຈາກງົບປະມານໂຄງການ)
  budgetName  String?  // ຊື່ໂຄງການ (ສຳລັບສະແດງຜົນ)
  remark      String?  // ໝາຍເຫດ
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// 📊 ຕາຕະລາງງົບປະມານ (Budget)
model Budget {
  id           Int      @id @default(autoincrement())
  projectName  String   // ຊື່ໂຄງການ/ງົບປະມານ
  categoryName String   // ໝວດໝູ່ / ແຫຼ່ງທຶນ
  totalAmount  Decimal  @db.Decimal(15, 2)
  isDeduct     Boolean  @default(false) // ຫັກເງິນບໍລິຫານຫຼືບໍ່
  deductType   String   @default("percent") // percent ຫຼື amount
  deductValue  Decimal  @default(0) @db.Decimal(15, 2)
  deductAmount Decimal  @default(0) @db.Decimal(15, 2)
  netAmount    Decimal  @db.Decimal(15, 2)
  usedAmount   Decimal  @default(0) @db.Decimal(15, 2)
  startDate    String?  // ວັນທີເລີ່ມຕົ້ນ
  endDate      String?  // ວັນທີສິ້ນສຸດ
  detail       String?  // ລາຍລະອຽດ
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// 📦 ຕາຕະລາງຊັບສິນ (Asset)
model Asset {
  id           Int      @id @default(autoincrement())
  assetCode    String   @unique // ລະຫັດຊັບສິນ (ເຊັ່ນ COM-2026-001)
  name         String   // ຊື່ຊັບສິນ
  categoryName String   // ໝວດໝູ່ຊັບສິນ
  purchaseDate String   // ວັນທີຈັດຊື້
  price        Decimal  @db.Decimal(15, 2)
  assignedTo   String   // ຜູ້ຮັບຜິດຊອບ / ບ່ອນຕັ້ງ
  status       String   @default("available") // available, in_use, maintenance, broken
  attachment   String?  // 💡 ເພີ່ມຖັນນີ້ສຳລັບເກັບຊື່ໄຟລ໌ຮູບພາບ/ເອກະສານ
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Category {
  id        Int        @id @default(autoincrement())
  name      String     // ຊື່ໝວດໝູ່
  type      String     // ປະເພດ: "INCOME", "EXPENSE", "ASSET"
  parentId  Int?       // ID ຂອງໝວດໝູ່ຫຼັກ (ຖ້າເປັນ null ແມ່່ນໝວດໝູ່ຫຼັກ)
  parent    Category?  @relation("CategoryToSub", fields: [parentId], references: [id], onDelete: Cascade)
  children  Category[] @relation("CategoryToSub")
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

// 📅 ຕາຕະລາງປະຫວັດການປິດບັນຊີປະຈຳປີ
model YearlyClose {
  id             Int      @id @default(autoincrement())
  year           Int      @unique // ປີງົບປະມານ ເຊັ່ນ 2024
  broughtForward Decimal  @default(0) @db.Decimal(15, 2)
  regularIncome  Decimal  @default(0) @db.Decimal(15, 2)
  totalExpense   Decimal  @default(0) @db.Decimal(15, 2)
  endingBalance  Decimal  @default(0) @db.Decimal(15, 2)
  isClosed       Boolean  @default(false) // ສະຖານະປິດບັນຊີ
  closedAt       DateTime?
  closedBy       String?  // ຜູ້ກົດປິດບັນຊີ
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}